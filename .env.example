# Ethereum RPC used for fork tests and deployment. Fork tests skip when this is empty. Forge loads .env by itself, so
# once this is set every plain `forge test` runs the fork suites too. The pinned fork block needs an archive node;
# otherwise also set FORK_BLOCK to a recent block, or run `forge test --no-match-path 'test/fork/*'`.
MAINNET_RPC_URL=

# Sepolia RPC for the testnet deployment (see README, Testnet).
SEPOLIA_RPC_URL=

# Etherscan API key for `--verify` and `forge verify-contract` (foundry.toml [etherscan]); one key covers mainnet and
# Sepolia.
ETHERSCAN_API_KEY=

# Required by script/DeployWeighted.s.sol: owner of the WeightedIndexFactory.
# On mainnet this must be a contract such as a Safe that needs at least three signatures and has no enabled module
# (a module acts as the Safe without signatures), not an EIP-7702 delegated wallet.
OWNER=

# Required by script/DeployWeighted.s.sol: guardian that can cancel pending listings and rebalances, start a rebalance
# that leaves a paused component or a stopped feed untouched, and delist tokens. Must differ from OWNER, and must not
# sign for the owner Safe. Replacing it later takes 7 days.
GUARDIAN=

# Required off chain 1 and chain 56 only; on those each defaults to the chain's address book and nothing else is
# accepted. PYTH is the contract every settlement reads its prices from; the rest are the zap's and MintRequests'.
# PYTH=0x...
# UNIVERSAL_ROUTER=0x...     Uniswap Universal Router 2.0.0, which the zap swaps through (V3 and V4)
# PANCAKE_ROUTER=0x...       PancakeSwap's v3 Universal Router; unset off a mainnet, the zap refuses PancakeSwap legs
# USDC=0x...                 the two stablecoins MintRequests escrows
# USDT=0x...

# BNB Chain RPC for the shelved BNB Chain deployment's fork suite, which skips when this is empty; BNB_FORK_BLOCK pins a
# recent block for a non-archive RPC.
BNB_RPC_URL=

# Never store a private key in this file. Deploy from an encrypted keystore:
#   cast wallet import deployer --interactive
#   forge script ... --account deployer --sender <deployer address>
# or from a hardware wallet with --ledger.
