# Ethereum RPC used for fork tests and deployment. Fork tests skip when this is empty.
# The pinned fork block needs an archive node; otherwise also set FORK_BLOCK to a recent block.
MAINNET_RPC_URL=

# Required by script/Deploy.s.sol: owner of the IndexFactory.
# On mainnet this must be a contract such as a Safe that needs at least two signatures, not an EIP-7702 delegated wallet.
OWNER=

# Required by script/Deploy.s.sol: guardian that can cancel pending listings and delist tokens.
# Must differ from OWNER. Replacing it later takes 7 days.
GUARDIAN=

# Required off mainnet only: Uniswap SwapRouter02 on the target chain.
# SWAP_ROUTER=0x...

# Never store a private key in this file. Deploy from an encrypted keystore:
#   cast wallet import deployer --interactive
#   forge script ... --account deployer --sender <deployer address>
# or from a hardware wallet with --ledger.
