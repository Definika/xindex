# Ethereum RPC used for fork tests and deployment. Fork tests skip when this is empty. Forge loads .env by itself, so
# once this is set every plain `forge test` runs the fork suites too. The pinned fork block needs an archive node;
# otherwise also set FORK_BLOCK to a recent block, or run `forge test --no-match-path 'test/fork/*'`.
MAINNET_RPC_URL=

# Sepolia RPC for the testnet deployment (see README, Testnet).
SEPOLIA_RPC_URL=

# Etherscan API key for `--verify` and `forge verify-contract` (foundry.toml [etherscan]); one key covers mainnet and
# Sepolia.
ETHERSCAN_API_KEY=

# Required by script/Deploy.s.sol: owner of the IndexFactory.
# On mainnet this must be a contract such as a Safe that needs at least two signatures and has no enabled module
# (a module acts as the Safe without signatures), not an EIP-7702 delegated wallet.
OWNER=

# Required by script/Deploy.s.sol: guardian that can cancel pending listings and rebalances, start a rebalance that
# leaves a paused component untouched, and delist tokens. Must differ from OWNER. Replacing it later takes 7 days.
GUARDIAN=

# Required off mainnet only; on chain 1 it defaults to the mainnet deployment. This is the deploy script's only
# market address: the rule prices from Chainlink feeds and the factory reads no Uniswap contract at all.
# UNIVERSAL_ROUTER=0x...     Uniswap Universal Router 2.0.0, which the zap swaps through (V3 and V4)

# Read by script/ConfigureWhitelist.s.sol with WHITELIST=default: the CompositeFeed over BTC/USD and WBTC/BTC that
# script/Deploy.s.sol deploys and logs on chain 1. The script checks it against both legs before proposing WBTC.
# WBTC_FEED=0x...

# Never store a private key in this file. Deploy from an encrypted keystore:
#   cast wallet import deployer --interactive
#   forge script ... --account deployer --sender <deployer address>
# or from a hardware wallet with --ledger.
