# The host crates' and the native tests' toolchain, pinned to the one the vault workspaces use (C1-07). SP1 builds its
# guests with its own `succinct` toolchain; RISC Zero's local build runs its own rustc under this cargo, and a mainnet
# image id comes from its Docker build (README). No key or image id is recorded yet that this pin could move.
[toolchain]
channel = "1.98.1"
components = ["llvm-tools", "rustc-dev"]