# Compiler files
cache/
out/

# Commonly ignored directories
.logs/
.ignore/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/
# Mainnet-fork rehearsals keep chain id 1, so their records land here too. Add a real mainnet deployment's record with
# `git add -f` after checking its transactions on-chain.
/broadcast/*/1/
# Sepolia-fork rehearsals keep chain id 11155111 for the same reason (SetupTestMarket refuses any other), so real Sepolia
# records are added with `git add -f` too (CR-I40). An ignore rule does not cover a file git already tracks: a rehearsal
# still overwrites the committed run-latest.json files, so check `git status` after one and restore them with
# `git checkout -- broadcast/`.
/broadcast/*/11155111/

# Docs
docs/

# Market-data snapshots behind design/analysis (about 4 MB); the scripts and their printed figures are the record.
/design/analysis/data/

# Dotenv file
.env
.env.*
!.env.example

# Wake's config and cache. CI regenerates the config from foundry.toml on every run (`wake init config --force`), so a
# committed copy would be a second, silently diverging set of remappings -- see the Wake step in .github/workflows.
wake.toml
.wake/
