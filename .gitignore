# Compiler files
cache/
out/

# Commonly ignored directories
.logs/
.ignore/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/
# Mainnet-fork rehearsals keep chain id 1, so their records land here too. Add a real mainnet deployment's record with
# `git add -f` after checking its transactions on-chain.
/broadcast/*/1/
# Sepolia-fork rehearsals keep chain id 11155111 for the same reason (SetupTestMarket refuses any other), so real Sepolia
# records are added with `git add -f` too (CR-I40). An ignore rule does not cover a file git already tracks: once a real
# record is committed, a rehearsal overwrites its run-latest.json, so check `git status` after one and restore it with
# `git checkout -- broadcast/`.
/broadcast/*/11155111/

# Docs
docs/

# Aderyn's default report, written by a local `aderyn .`
/report.md

# Dotenv file
.env
.env.*
!.env.example

# Wake's config and cache. CI regenerates the config from foundry.toml on every run (`wake init config --force`), so a
# committed copy would be a second, silently diverging set of remappings -- see the Wake step in .github/workflows.
wake.toml
.wake/

# The keeper bot
/keeper/node_modules/
/keeper/out/
/keeper/cache/
__pycache__/

# macOS Finder's folder metadata, binary: test/Repo.t.sol skips it where it reads every file
.DS_Store
