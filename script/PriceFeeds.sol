pragma solidity 0.8.28;

import {IPythPrices} from "../src/interfaces/IPythPrices.sol";
import {Listings} from "./Listings.sol";
import {BnbChainAddresses} from "./BnbChainAddresses.sol";
import {BaseAddresses} from "./BaseAddresses.sol";

/// @notice The Pyth feed of every listed token on each chain, which `ConfigureWeighted` proposes to the factory: the
///         price a rebalance fill is checked against (the owner's call of 2026-11-22, `design/2026-11-22-pyth-check.md`).
///         Each table runs in its chain's list order: `Listings.all()`, `BnbChainAddresses.all()` and
///         `BaseAddresses.all()`, and `test/ConfigureWeighted.t.sol` pins each entry against the chain's list and the
///         keeper's catalogue.
/// @dev Where each id comes from:
///      - Ethereum: `PythIds`, as the keeper's catalogue (`keeper/bot/price-ids.mjs`) holds it: every coin at its own
///        feed, and each of Ondo's 353 stocks and ETFs at its token's own feed where Pyth has one (9) and otherwise at
///        its share's. A share's feed leaves out the token's multiplier (`sValue`, the reinvested dividends, about 1%
///        on SPYon on 2026-11-23), which the check therefore misses, and a split moves that multiplier tenfold: the
///        guardian keeps such a leg out of a rebalance around a corporate action, as Ondo announces each at least 24
///        hours ahead (the owner's call of 2026-11-23, renewing the procedure of 2026-10-18,
///        `design/2026-10-18-pre-mainnet-readings.md`, section 2).
///      - BNB Chain: WBNB at BNB/USD; BTCB at BTC/USD, Pyth having no BTCB feed and Binance backing it one for one;
///        ETH, XRP, ZEC, ADA, BCH, LTC, DOT, ATOM, ASTER and STABLE at their coins' feeds; each Ondo token at the feed
///        Ethereum's Ondo token of the same ticker takes.
///      - Base: WETH at ETH/USD, AERO and ZRO at their own feeds, each copy of Base's bridge at its Ethereum coin's,
///        cbBTC and cbETH at their own, cbXRP, cbDOGE, cbLTC and cbADA at their coins', and each Coinbase stock token,
///        as a `Multiplier`, at its share's US feed.
///      Read from Pyth's catalogue (Hermes `/v2/price_feeds`) on 2026-11-22, each checked to name its coin or share;
///      Ondo's from `PythIds` as of `bcb3d0f`.
///      A feed Pyth has never been updated with on a chain is not yet known to its contract there, and the factory
///      refuses to propose it: a first update of each, by anyone, comes before the proposals (`docs/deployment.md`).
library PriceFeeds {
    /// @notice How many entries each table holds: its chain's list's `COUNT`, which a test pins.
    uint256 internal constant ETHEREUM_COUNT = 415;
    uint256 internal constant BNB_COUNT = 365;
    uint256 internal constant BASE_COUNT = 32;

    /// @notice `token`'s feed on chain `chainId`, or kind `None` for a token off that chain's list. Each call builds
    ///         the chain's whole table, and memory is never freed within a call: a loop over a list looks its tokens up
    ///         in one {table} with {find} instead, since 415 calls of this one run out of memory.
    function feedOf(uint256 chainId, address token) internal pure returns (IPythPrices.PriceFeed memory feed) {
        (address[] memory tokens, IPythPrices.PriceFeed[] memory feeds) = table(chainId);
        return find(token, tokens, feeds);
    }

    /// @notice Chain `chainId`'s listed tokens and their feeds, in list order; both empty off the three chains.
    function table(uint256 chainId)
        internal
        pure
        returns (address[] memory tokens, IPythPrices.PriceFeed[] memory feeds)
    {
        if (chainId == 1) return (Listings.all(), _ethereum());
        if (chainId == BnbChainAddresses.CHAIN_ID) return (BnbChainAddresses.all(), _bnb());
        if (chainId == BaseAddresses.CHAIN_ID) return (BaseAddresses.all(), _base());
    }

    /// @notice `token`'s feed in a {table}, or kind `None` when the table does not list it. Allocates nothing.
    function find(address token, address[] memory tokens, IPythPrices.PriceFeed[] memory feeds)
        internal
        pure
        returns (IPythPrices.PriceFeed memory feed)
    {
        for (uint256 i = 0; i < tokens.length; ++i) {
            if (tokens[i] == token) return feeds[i];
        }
        return feed;
    }

    function _ethereum() private pure returns (IPythPrices.PriceFeed[] memory) {
        (bytes32[ETHEREUM_COUNT] memory ids, uint8[ETHEREUM_COUNT] memory kinds) = ethereum();
        IPythPrices.PriceFeed[] memory feeds = new IPythPrices.PriceFeed[](ids.length);
        for (uint256 i = 0; i < ids.length; ++i) {
            feeds[i] = IPythPrices.PriceFeed({id: ids[i], kind: IPythPrices.FeedKind(kinds[i])});
        }
        return feeds;
    }

    function _bnb() private pure returns (IPythPrices.PriceFeed[] memory) {
        (bytes32[BNB_COUNT] memory ids, uint8[BNB_COUNT] memory kinds) = bnb();
        IPythPrices.PriceFeed[] memory feeds = new IPythPrices.PriceFeed[](ids.length);
        for (uint256 i = 0; i < ids.length; ++i) {
            feeds[i] = IPythPrices.PriceFeed({id: ids[i], kind: IPythPrices.FeedKind(kinds[i])});
        }
        return feeds;
    }

    function _base() private pure returns (IPythPrices.PriceFeed[] memory) {
        (bytes32[BASE_COUNT] memory ids, uint8[BASE_COUNT] memory kinds) = base();
        IPythPrices.PriceFeed[] memory feeds = new IPythPrices.PriceFeed[](ids.length);
        for (uint256 i = 0; i < ids.length; ++i) {
            feeds[i] = IPythPrices.PriceFeed({id: ids[i], kind: IPythPrices.FeedKind(kinds[i])});
        }
        return feeds;
    }

