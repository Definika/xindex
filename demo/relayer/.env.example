# TESTNETS ONLY. Copy to .env (git-ignored) and fill in. Never put a mainnet key here.
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
HYPEREVM_RPC=https://rpc.hyperliquid-testnet.xyz/evm
SOLANA_RPC=https://api.devnet.solana.com

# EVM keys (0x...): the two stub relayers on HyperEVM (P1, P2), the stub state relayer on Sepolia, and the account that
# sends settle / claim / demo transactions on Sepolia and HyperEVM.
RELAYER1_KEY=
RELAYER2_KEY=
STATE_RELAYER_KEY=
SENDER_KEY=

# Solana keypair files (JSON arrays, as solana-keygen writes them): the two stub relayers, the vault's deployer (its
# upgrade authority), and the demo depositor.
SOLANA_RELAYER1=./keys/solana-relayer1.json
SOLANA_RELAYER2=./keys/solana-relayer2.json
SOLANA_DEPLOYER=~/.config/solana/id.json
SOLANA_DEPOSITOR=./keys/solana-depositor.json

# Solana program ids: the vault, and the stub deployed twice (P1, P2).
SOLANA_VAULT_PROGRAM=7HREqSpWGMXWn9VxADLNJU9M4MN11JqgbdtsntUsJsjg
SOLANA_P1_PROGRAM=
SOLANA_P2_PROGRAM=
# The Solana vault's freeze key.
SOLANA_FREEZER=

# How deep a Sepolia log must be before it is relayed: "finalized" (as P1 and P2 will prove), or a number of blocks.
CONFIRMATIONS=finalized

# BNB testnet, the chain with real proofs (all of it but P2's stub). BNB_RPC must serve eth_getProof at its head.
BNB_RPC=https://bsc-testnet-rpc.publicnode.com
# Sepolia's beacon node, which P1's input builder reads votes and committees from.
SEPOLIA_BEACON=https://ethereum-sepolia-beacon-api.publicnode.com
# Where P1 downloads finalized Sepolia states from.
SEPOLIA_CHECKPOINT_SYNC=https://checkpoint-sync.sepolia.ethpandaops.io
# How P1 proves: "network" with NETWORK_PRIVATE_KEY (Succinct's prover network), or "cuda" on an NVIDIA GPU. Unset,
# the relayer does not prove, and messages to BNB testnet wait.
SP1_PROVER=
NETWORK_PRIVATE_KEY=
