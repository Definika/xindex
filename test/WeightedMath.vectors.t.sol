pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {SafeCast} from "@openzeppelin/contracts/utils/math/SafeCast.sol";
import {WeightedMath} from "../src/WeightedMath.sol";
import {IWeightedHub} from "../src/interfaces/IWeightedHub.sol";
import {IXindexErrors} from "../src/interfaces/IXindexErrors.sol";

/// @notice Replays `test/vectors/settlement.json` against `WeightedMath.settlement`: every vector's answer, word for
///         word, as the exact-rational model of `test/vectors/settlement.py` computed it (the record is
///         `design/2026-11-10-oracle-free-rebalance.md`). The model is written from the spec, not from the contract, so
///         a chained rounding, an overflow or a cap applied in the wrong place shows as a mismatch.
/// @dev The vectors are committed, generated by a seeded script, and read through `vm.readFile` under
///      `fs_permissions`, never through `ffi`. A change to the arithmetic regenerates them in the same commit.
contract WeightedMathVectorsTest is Test {
    /// @dev One vector, its fields in the alphabetical order `vm.parseJson` encodes an object's keys in.
    struct Vector {
        uint256[] amountsIn;
        uint256[] amountsOut;
        uint256 badLeg;
        uint256 badUnits;
        uint256 bar;
        uint256 elapsed;
        int256 gain;
        uint256 highest;
        uint256 keepMask;
        string kind;
        uint256 lowest;
        uint256[] newUnits;
        uint256 outcome;
        uint256 scale;
        uint256 supply;
        uint256[] units;
        uint256[] weights;
    }

    uint256 constant SETTLES = 0;
    uint256 constant EMPTY = 1;
    uint256 constant BOUNDS = 2;
    uint256 constant OVERFLOW = 3;
    uint256 constant BELOW = 4;
    uint256 constant LENGTH = 5;
    uint256 constant ELAPSED = 6;
    uint256 constant WAD = 1e18;

    WeightedMath math;

    function setUp() public {
        math = new WeightedMath();
    }

    /// @dev The file, kept in memory: in storage, every parse would read its 200 KB back word by word.
    /// @dev One vector of the quote's check, its fields in the same alphabetical order.
    struct Quote {
        uint256 floor;
        uint256 holds;
        uint256[] newUnits;
        uint256[] prices;
        uint256 tolerance;
        uint256[] units;
        uint256 valueIn;
        uint256 valueOut;
    }

    function _file() internal view returns (string memory json, uint256 count) {
        json = vm.readFile("test/vectors/settlement.json");
        count = vm.parseJsonUint(json, ".count");
    }

    function _vector(string memory json, uint256 i) internal pure returns (Vector memory) {
        return abi.decode(vm.parseJson(json, string.concat(".vectors[", vm.toString(i), "]")), (Vector));
    }

    function _at(uint256 i, Vector memory v, string memory what) internal pure returns (string memory) {
        return string.concat("vector ", vm.toString(i), " (", v.kind, "): ", what);
    }

    /// @dev The revert data the model's refusal stands for.
    function _refusal(Vector memory v) internal pure returns (bytes memory) {
        if (v.outcome == EMPTY) return abi.encodeWithSelector(IWeightedHub.NothingToRebalance.selector);
        if (v.outcome == BOUNDS) {
            return
                abi.encodeWithSelector(IWeightedHub.LegOutOfBounds.selector, v.badLeg, v.badUnits, v.lowest, v.highest);
        }
        if (v.outcome == OVERFLOW) {
            return abi.encodeWithSelector(SafeCast.SafeCastOverflowedUintDowncast.selector, 96, v.badUnits);
        }
        if (v.outcome == BELOW) return abi.encodeWithSelector(IWeightedHub.GainBelowBar.selector, v.gain, v.bar);
        if (v.outcome == LENGTH) return abi.encodeWithSelector(IXindexErrors.LengthMismatch.selector);
        return abi.encodeWithSelector(IWeightedHub.AuctionOver.selector, v.elapsed);
    }

    /// @dev Every vector: the contract settles or refuses exactly as the model says, with the model's bar, gain and
    ///      amounts, or the model's revert data.
    function test_everyVectorSettlesAsTheExactModelSays() public view {
        (string memory json, uint256 count) = _file();
        for (uint256 i = 0; i < count; ++i) {
            Vector memory v = _vector(json, i);
            try math.settlement(v.elapsed, v.supply, v.scale, v.units, v.newUnits, v.weights, v.keepMask) returns (
                uint256 bar, int256 gain, uint256[] memory amountsOut, uint256[] memory amountsIn
            ) {
                assertEq(v.outcome, SETTLES, _at(i, v, "settled where the model reverts"));
                assertEq(bar, v.bar, _at(i, v, "bar"));
                assertEq(gain, v.gain, _at(i, v, "gain"));
                assertEq(amountsOut, v.amountsOut, _at(i, v, "amountsOut"));
                assertEq(amountsIn, v.amountsIn, _at(i, v, "amountsIn"));
                assertEq(math.barAt(v.elapsed), v.bar, _at(i, v, "barAt"));
            } catch (bytes memory err) {
                assertTrue(v.outcome != SETTLES, _at(i, v, "reverted where the model settles"));
                assertEq(err, _refusal(v), _at(i, v, "revert"));
            }
        }
    }

    /// @dev The committed vectors reach every path the model has: settlements and each refusal, kept legs, a scale
    ///      below one, a gain exactly on the bar, a negative gain, and both caps binding. Counted here from the vectors
    ///      themselves, not read from the file's summary, so a regenerated file that lost a path fails. And the facts
    ///      the model owes the spec hold on every settled vector: the gain clears the bar, the bar is positive, a leg
    ///      never both sends and receives, a kept leg's units do not move, and every leg is inside its caps.
    /// @dev The quote's check against the exact model: it passes where the model's quote holds, and where it does
    ///      not it reverts with the model's value in and floor, to the unit.
    function test_everyQuoteHoldsOrFailsAsTheExactModelSays() public view {
        string memory json = vm.readFile("test/vectors/settlement.json");
        Quote[] memory quotes = abi.decode(vm.parseJson(json, ".quotes"), (Quote[]));
        assertEq(quotes.length, 77);
        uint256 held = 0;
        for (uint256 i = 0; i < quotes.length; ++i) {
            Quote memory q = quotes[i];
            try math.quoteCheck(q.units, q.newUnits, q.prices, q.tolerance) {
                assertEq(q.holds, 1, string.concat("quote ", vm.toString(i), " holds in the model"));
                assertGe(q.valueIn, q.floor);
                ++held;
            } catch (bytes memory reason) {
                assertEq(q.holds, 0, string.concat("quote ", vm.toString(i), " fails in the model"));
                assertEq(
                    reason,
                    abi.encodeWithSelector(IWeightedHub.BelowQuote.selector, q.valueIn, q.floor),
                    string.concat("quote ", vm.toString(i), ": the refusal")
                );
            }
        }
        assertGe(held, 15, "the vectors hold some quotes");
        assertGe(quotes.length - held, 15, "and fail others");
    }

    function test_theVectorsReachEveryPath() public view {
        uint256[7] memory outcomes;
        uint256 kept = 0;
        uint256 scaled = 0;
        uint256 onTheBar = 0;
        uint256 negative = 0;
        uint256 turnoverBound = 0;
        uint256 growthBound = 0;
        (string memory json, uint256 count) = _file();
        for (uint256 i = 0; i < count; ++i) {
            Vector memory v = _vector(json, i);
            uint256 n = v.units.length;
            assertEq(v.weights.length, n, _at(i, v, "weights"));
            ++outcomes[v.outcome];
            if (v.keepMask != 0) ++kept;
            if (v.scale != WAD) ++scaled;
            if (v.outcome == BELOW && v.gain < 0) ++negative;
            if (v.outcome != SETTLES) continue;
            assertGt(v.bar, 0, _at(i, v, "the bar is positive"));
            assertGe(v.gain, int256(v.bar), _at(i, v, "the gain clears the bar"));
            if (v.gain == int256(v.bar)) ++onTheBar;
            bool atTurnover = false;
            bool atGrowth = false;
            for (uint256 j = 0; j < n; ++j) {
                uint256 u = v.units[j];
                uint256 next = v.newUnits[j];
                assertFalse(v.amountsOut[j] != 0 && v.amountsIn[j] != 0, _at(i, v, "a leg moves one way"));
                if ((v.keepMask >> j) & 1 != 0) assertEq(next, u, _at(i, v, "a kept leg stays"));
                assertGe(next * 10, u * 8, _at(i, v, "a leg keeps four fifths of its units"));
                assertLe(next, 2 * u, _at(i, v, "a leg at most doubles"));
                if (next < u && (next - 1) * 10 < u * 8) atTurnover = true;
                if (next == 2 * u) atGrowth = true;
            }
            if (atTurnover) ++turnoverBound;
            if (atGrowth) ++growthBound;
        }
        assertGe(outcomes[SETTLES], 150, "settlements");
        assertGe(outcomes[EMPTY], 3, "an empty supply");
        assertGe(outcomes[BOUNDS], 40, "a leg outside its caps");
        assertGe(outcomes[OVERFLOW], 10, "overflows");
        assertGe(outcomes[BELOW], 60, "a gain under the bar");
        assertGe(outcomes[LENGTH], 4, "a list of another length");
        assertGe(outcomes[ELAPSED], 5, "past the auction");
        assertGe(kept, 30, "kept legs");
        assertGe(scaled, 20, "a scale below one");
        assertGe(onTheBar, 3, "a gain exactly on the bar");
        assertGe(negative, 10, "a negative gain");
        assertGe(turnoverBound, 10, "the turnover cap binding");
        assertGe(growthBound, 10, "the growth cap binding");
    }
}
