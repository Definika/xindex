pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {SafeCast} from "@openzeppelin/contracts/utils/math/SafeCast.sol";
import {WeightedMath} from "../src/WeightedMath.sol";
import {IWeightedHub} from "../src/interfaces/IWeightedHub.sol";

/// @notice Replays `test/vectors/settlement.json` against `WeightedMath.settlement`: every vector's answer, word for
///         word, as the exact-rational model of `test/vectors/settlement.py` computed it (the record is
///         `design/2026-10-29-settlement-vectors.md`). The model is written from the spec, not from the contract, so
///         a chained rounding, an overflow or a cap applied in the wrong place shows as a mismatch.
/// @dev The vectors are committed, generated by a seeded script, and read through `vm.readFile` under
///      `fs_permissions`, never through `ffi`. A change to the arithmetic regenerates them in the same commit.
contract WeightedMathVectorsTest is Test {
    /// @dev One vector, its fields in the alphabetical order `vm.parseJson` encodes an object's keys in.
    struct Vector {
        uint256[] amountsIn;
        uint256[] amountsOut;
        uint256 keepMask;
        string kind;
        uint256 mu;
        uint256 muUsed;
        uint256 outcome;
        uint256 overflowValue;
        uint256[] prices;
        uint256 scale;
        uint256 supply;
        uint256[] units;
        uint256[] unitsAfter;
        uint256[] weights;
    }

    uint256 constant SETTLES = 0;
    uint256 constant NOTHING = 1;
    uint256 constant OVERFLOW = 2;
    uint256 constant WAD = 1e18;

    WeightedMath math;

    function setUp() public {
        math = new WeightedMath();
    }

    /// @dev The file, kept in memory: in storage, every parse would read its 200 KB back word by word.
    function _file() internal view returns (string memory json, uint256 count) {
        json = vm.readFile("test/vectors/settlement.json");
        count = vm.parseJsonUint(json, ".count");
    }

    function _vector(string memory json, uint256 i) internal pure returns (Vector memory) {
        return abi.decode(vm.parseJson(json, string.concat(".vectors[", vm.toString(i), "]")), (Vector));
    }

    function _at(uint256 i, Vector memory v, string memory what) internal pure returns (string memory) {
        return string.concat("vector ", vm.toString(i), " (", v.kind, "): ", what);
    }

    /// @dev Every vector: the contract settles, refuses or overflows exactly as the model says, with the model's
    ///      multiplier, units and amounts, or the model's revert data.
    function test_everyVectorSettlesAsTheExactModelSays() public view {
        (string memory json, uint256 count) = _file();
        for (uint256 i = 0; i < count; ++i) {
            Vector memory v = _vector(json, i);
            try math.settlement(v.mu, v.prices, v.supply, v.scale, v.units, v.weights, v.keepMask) returns (
                uint256 muUsed, uint256[] memory units, uint256[] memory amountsOut, uint256[] memory amountsIn
            ) {
                assertEq(v.outcome, SETTLES, _at(i, v, "settled where the model reverts"));
                assertEq(muUsed, v.muUsed, _at(i, v, "muUsed"));
                assertEq(units, v.unitsAfter, _at(i, v, "units"));
                assertEq(amountsOut, v.amountsOut, _at(i, v, "amountsOut"));
                assertEq(amountsIn, v.amountsIn, _at(i, v, "amountsIn"));
            } catch (bytes memory err) {
                if (v.outcome == NOTHING) {
                    assertEq(err, abi.encodeWithSelector(IWeightedHub.NothingToRebalance.selector), _at(i, v, "revert"));
                } else if (v.outcome == OVERFLOW) {
                    assertEq(
                        err,
                        abi.encodeWithSelector(SafeCast.SafeCastOverflowedUintDowncast.selector, 96, v.overflowValue),
                        _at(i, v, "revert")
                    );
                } else {
                    assertTrue(false, _at(i, v, "reverted where the model settles"));
                }
            }
        }
    }

    /// @dev The committed vectors reach every path the model has: settlements, refusals and overflows, fills redone
    ///      at MU_MAX, kept legs, a scale below one, an empty supply and the turnover cap binding. Counted here from
    ///      the vectors themselves, not read from the file's summary, so a regenerated file that lost a path fails.
    ///      And three facts the model owes the spec hold on every settled vector: the multiplier is the auction's or
    ///      MU_MAX, a leg never both sends and receives, and a kept leg's units do not move.
    function test_theVectorsReachEveryPath() public view {
        uint256 settles = 0;
        uint256 nothing = 0;
        uint256 overflow = 0;
        uint256 redone = 0;
        uint256 kept = 0;
        uint256 scaled = 0;
        uint256 empty = 0;
        uint256 turnoverBound = 0;
        (string memory json, uint256 count) = _file();
        for (uint256 i = 0; i < count; ++i) {
            Vector memory v = _vector(json, i);
            uint256 n = v.units.length;
            assertEq(v.prices.length, n, _at(i, v, "prices"));
            assertEq(v.weights.length, n, _at(i, v, "weights"));
            if (v.keepMask != 0) ++kept;
            if (v.scale != WAD) ++scaled;
            if (v.supply == 0) ++empty;
            if (v.outcome == NOTHING) ++nothing;
            if (v.outcome == OVERFLOW) ++overflow;
            if (v.outcome != SETTLES) continue;
            ++settles;
            if (v.muUsed != v.mu) {
                ++redone;
                assertEq(v.muUsed, math.MU_MAX(), _at(i, v, "a redone fill is at MU_MAX"));
            }
            for (uint256 j = 0; j < n; ++j) {
                assertFalse(v.amountsOut[j] != 0 && v.amountsIn[j] != 0, _at(i, v, "a leg moves one way"));
                if ((v.keepMask >> j) & 1 != 0) assertEq(v.unitsAfter[j], v.units[j], _at(i, v, "a kept leg stays"));
                if (v.unitsAfter[j] < v.units[j] && (v.units[j] - v.unitsAfter[j]) * 10_000 >= v.units[j] * 1_999) {
                    ++turnoverBound;
                    break;
                }
            }
        }
        assertGe(settles, 250, "settlements");
        assertGe(nothing, 30, "refusals");
        assertGe(overflow, 10, "overflows");
        assertGe(redone, 10, "fills redone at MU_MAX");
        assertGe(kept, 30, "kept legs");
        assertGe(scaled, 20, "a scale below one");
        assertGe(empty, 3, "an empty supply");
        assertGe(turnoverBound, 20, "the turnover cap binding");
    }
}
